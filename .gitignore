:root {
  --bg: #f4f7fb;
  --panel: #ffffff;
  --primary: #0f7ae5;
  --primary-dark: #0b5eb4;
  --text: #1f2937;
  --muted: #6b7280;
  --border: #e5e7eb;
  --green: #16a34a;
  --yellow: #f59e0b;
  --gray: #94a3b8;
  --shadow: 0 12px 30px rgba(15, 23, 42, 0.08);
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  min-height: 100vh;
  font-family: Inter, Arial, sans-serif;
  background: linear-gradient(135deg, #eef4ff, #f7f9fc);
  color: var(--text);
}

button,
input {
  font: inherit;
}

#root {
  min-height: 100vh;
}

.auth-page {
  min-height: 100vh;
  display: grid;
  place-items: center;
  padding: 24px;
}

.auth-card {
  width: min(520px, 100%);
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 24px;
  padding: 32px;
  box-shadow: var(--shadow);
}

.brand {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 24px;
}

.brand-mark {
  width: 42px;
  height: 42px;
  border-radius: 12px;
  display: grid;
  place-items: center;
  background: linear-gradient(135deg, var(--primary), #6ea8ff);
  color: white;
  font-weight: 700;
}

.auth-card h2 {
  margin: 0 0 8px;
  font-size: 2rem;
}

.auth-card p {
  color: var(--muted);
  margin-bottom: 20px;
}

.demo-accounts {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-bottom: 18px;
}

.account-pill {
  border: 1px solid var(--border);
  background: #f8fafc;
  color: var(--text);
  border-radius: 999px;
  padding: 8px 12px;
  cursor: pointer;
  transition: 0.2s ease;
}

.account-pill:hover {
  border-color: var(--primary);
  color: var(--primary);
}

.login-form {
  display: flex;
  flex-direction: column;
  gap: 18px;
}

.login-form label {
  display: flex;
  flex-direction: column;
  gap: 8px;
  font-weight: 600;
}

.login-form input {
  border: 1px solid var(--border);
  background: #f8fafc;
  padding: 14px 16px;
  border-radius: 12px;
  outline: none;
}

.login-form input:focus {
  border-color: var(--primary);
  box-shadow: 0 0 0 3px rgba(15, 122, 229, 0.12);
}

.primary-btn,
.secondary-btn {
  border: none;
  border-radius: 12px;
  padding: 12px 18px;
  cursor: pointer;
  font-weight: 600;
  transition: 0.2s ease;
}

.primary-btn {
  background: var(--primary);
  color: white;
}

.primary-btn:hover {
  background: var(--primary-dark);
}

.secondary-btn {
  background: #eef2ff;
  color: var(--primary-dark);
}

.error {
  color: #b91c1c;
  background: #fee2e2;
  border: 1px solid #fecaca;
  padding: 10px 12px;
  border-radius: 10px;
  font-size: 0.9rem;
}

.demo-box {
  margin-top: 20px;
  padding: 14px 16px;
  background: #f8fafc;
  border-radius: 12px;
  border: 1px solid var(--border);
  color: var(--muted);
}

.demo-box strong {
  display: block;
  margin-bottom: 8px;
  color: var(--text);
}

.demo-box ul {
  margin: 0;
  padding-left: 18px;
  line-height: 1.8;
}

.dashboard {
  max-width: 1200px;
  margin: 0 auto;
  padding: 32px 20px 48px;
}

.topbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20px;
  margin-bottom: 24px;
}

.eyebrow {
  margin: 0;
  font-size: 0.8rem;
  text-transform: uppercase;
  color: var(--primary);
  letter-spacing: 0.08em;
}

.eyebrow.accent {
  color: var(--green);
}

.topbar h1 {
  margin: 6px 0 0;
  font-size: clamp(2rem, 3vw, 2.7rem);
}

.user-box {
  display: flex;
  align-items: center;
  gap: 12px;
  background: rgba(255, 255, 255, 0.8);
  border: 1px solid var(--border);
  border-radius: 16px;
  padding: 10px 14px;
}

.avatar {
  width: 42px;
  height: 42px;
  border-radius: 50%;
  background: linear-gradient(135deg, #1d4ed8, #60a5fa);
  color: white;
  display: grid;
  place-items: center;
  font-weight: 700;
}

.user-box strong,
.user-box small {
  display: block;
}

.user-box small {
  color: var(--muted);
}

.hero-card {
  background: linear-gradient(135deg, #0f172a, #1d4ed8);
  color: white;
  border-radius: 22px;
  padding: 24px 26px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20px;
  margin-bottom: 28px;
  box-shadow: var(--shadow);
}

.hero-card h2 {
  margin: 10px 0 0;
  font-size: clamp(1.4rem, 2vw, 2rem);
  max-width: 700px;
  line-height: 1.4;
}

.hero-badge {
  background: rgba(255, 255, 255, 0.12);
  border: 1px solid rgba(255, 255, 255, 0.18);
  border-radius: 999px;
  padding: 10px 14px;
  font-weight: 600;
  white-space: nowrap;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(180px, 1fr));
  gap: 18px;
  margin-bottom: 28px;
}

.stat-card {
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 18px;
  padding: 20px 18px;
  box-shadow: var(--shadow);
}

.stat-card span {
  display: block;
  color: var(--muted);
  margin-bottom: 12px;
  font-size: 0.9rem;
}

.stat-card strong {
  font-size: 1.8rem;
}

.stat-card.primary {
  border-top: 4px solid var(--primary);
}

.stat-card.secondary {
  border-top: 4px solid #8b5cf6;
}

.stat-card.success {
  border-top: 4px solid var(--green);
}

.main-grid {
  display: grid;
  grid-template-columns: 1.2fr 0.8fr;
  gap: 20px;
  margin-bottom: 28px;
}

.panel,
.updates-panel {
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 22px;
  padding: 22px;
  box-shadow: var(--shadow);
}

.panel-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 18px;
}

.panel-header h3 {
  margin: 0;
  font-size: 1.2rem;
}

.panel-header span {
  color: var(--muted);
  font-size: 0.9rem;
}

.progress-bar {
  width: 100%;
  height: 14px;
  background: #edf2f7;
  border-radius: 999px;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, var(--primary), #6ea8ff);
}

.progress-legend {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  margin-top: 18px;
  color: var(--muted);
  font-size: 0.9rem;
  flex-wrap: wrap;
}

.dot {
  width: 10px;
  height: 10px;
  display: inline-block;
  border-radius: 50%;
  margin-right: 8px;
}

.dot.green {
  background: var(--green);
}

.dot.yellow {
  background: var(--yellow);
}

.dot.gray {
  background: var(--gray);
}

.site-card {
  display: grid;
  grid-template-columns: 180px 1fr;
  gap: 18px;
  align-items: center;
}

.site-image {
  background: linear-gradient(135deg, #dfeeff, #cfe4ff);
  min-height: 180px;
  border-radius: 18px;
  position: relative;
  overflow: hidden;
}

.site-image::before {
  content: "";
  position: absolute;
  inset: 18px 22px 18px 22px;
  border-radius: 14px;
  background:
    linear-gradient(#d7ecff, #d7ecff) 0 0 / 100% 48% no-repeat,
    linear-gradient(#b7d7ff, #b7d7ff) 0 100% / 100% 52% no-repeat;
}

.site-info h4 {
  margin: 0 0 8px;
  font-size: 1.3rem;
}

.site-info p {
  margin: 0 0 10px;
  color: var(--muted);
}

.site-info ul {
  margin: 0;
  padding-left: 18px;
  color: var(--text);
  line-height: 1.8;
}

.timeline {
  position: relative;
  margin-top: 18px;
  display: flex;
  flex-direction: column;
  gap: 18px;
}

.timeline::before {
  content: "";
  position: absolute;
  left: 11px;
  top: 0;
  bottom: 0;
  width: 2px;
  background: #dfe7f3;
}

.timeline-item {
  position: relative;
  display: grid;
  grid-template-columns: 26px 1fr;
  gap: 16px;
  align-items: flex-start;
}

.timeline-mark {
  width: 24px;
  height: 24px;
  border-radius: 50%;
  background: var(--primary);
  border: 4px solid #eaf3ff;
  position: relative;
  z-index: 1;
  margin-top: 4px;
}

.timeline-content {
  background: #f8fafc;
  border: 1px solid var(--border);
  border-radius: 16px;
  padding: 16px 18px;
}

.timeline-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  margin-bottom: 8px;
}

.timeline-top h4 {
  margin: 0;
  font-size: 1.05rem;
}

.timeline-content small {
  color: var(--muted);
  display: block;
  margin-bottom: 10px;
}

.timeline-content p {
  margin: 0 0 14px;
  color: var(--text);
  line-height: 1.6;
}

.status {
  padding: 7px 10px;
  border-radius: 999px;
  font-size: 0.72rem;
  font-weight: 700;
  white-space: nowrap;
}

.status.completed {
  background: #dcfce7;
  color: #166534;
}

.status.in-progress {
  background: #fef3c7;
  color: #92400e;
}

.status.upcoming {
  background: #e2e8f0;
  color: #334155;
}

.mini-progress {
  width: 100%;
  height: 10px;
  background: #e2e8f0;
  border-radius: 999px;
  overflow: hidden;
}

.mini-progress > div {
  height: 100%;
  background: linear-gradient(90deg, var(--primary), #80c8ff);
  border-radius: inherit;
}

@media (max-width: 820px) {
  .main-grid,
  .stats-grid {
    grid-template-columns: 1fr;
  }

  .topbar,
  .site-card {
    display: block;
  }

  .user-box {
    margin-top: 16px;
    width: fit-content;
  }

  .hero-card {
    display: block;
  }
}
